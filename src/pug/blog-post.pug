doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='云芯互联新闻详情：面向 AI 集群的高速互联参考方案。')
        meta(name='author', content='云芯互联')

        title 面向 AI 集群的高速互联参考方案 - 云芯互联

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Page Content
            section.py-5
                .container.px-5.my-5

                    .row.gx-5

                        .col-lg-3
                            .card.border-0.shadow-sm.mb-4
                                .card-body.p-4
                                    .fw-bold 云芯互联新闻中心
                                    .text-muted 产品动态 · 技术文章
                                    hr
                                    .small.text-muted 发布日期
                                    .fw-bold 2026年6月
                                    .small.text-muted.mt-3 联系邮箱
                                    a(href='mailto:media@cloudcore.example') media@cloudcore.example

                        .col-lg-9

                            // Post content
                            article

                                // Post header
                                header.mb-4
                                    a.text-decoration-none(href='blog-home.html')
                                        i.bi.bi-arrow-left.me-1
                                        | 返回新闻动态
                                    h1.fw-bolder.mb-3.mt-3 云芯互联推出面向 AI 集群的高速互联参考方案
                                    .text-muted.fst-italic.mb-3 2026年6月 · 产品动态
                                    a.badge.bg-secondary.text-decoration-none.link-light.me-2(href='#!') AI 集群
                                    a.badge.bg-secondary.text-decoration-none.link-light(href='#!') 高速互联

                                // Preview visual
                                figure.mb-4
                                    .news-visual.rounded

                                // Post content
                                section.mb-5
                                    p.fs-5.mb-4 随着大模型训练、推理和多模态应用持续发展，AI 集群对网络基础设施提出了更高要求：更高带宽、更低时延、更强可观测能力以及更稳定的规模化部署体验。
                                    p.fs-5.mb-4 云芯互联参考方案围绕数据中心互联芯片、智能网卡 / DPU 和系统软件工具链展开，帮助客户在方案评估阶段快速验证关键性能指标。
                                    h2.fw-bolder.mb-4.mt-5 方案关注的关键能力
                                    p.fs-5.mb-4 第一，面向东西向流量优化数据通路，降低跨节点通信开销；第二，通过硬件卸载释放主机 CPU 资源；第三，结合遥测与调试工具，提升集群运维效率。
                                    p.fs-5.mb-4 在客户导入阶段，云芯互联可提供联合验证支持，包括场景建模、性能测试、问题定位和版本迭代建议。
                                    h2.fw-bolder.mb-4.mt-5 面向产业生态的长期协作
                                    p.fs-5.mb-4 高速互联芯片不是单点产品，而是连接服务器、交换网络、系统软件和上层业务的基础平台。云芯互联将持续与生态伙伴协作，共同推进智能算力网络基础设施演进。
                                    .alert.alert-info.mt-5
                                        strong 说明：
                                        | 本页面为示例新闻稿，具体产品名称、指标和发布时间请替换为真实信息。

                            // Related links
                            section
                                .card.section-muted.border-0
                                    .card-body.p-4
                                        h3.h5.fw-bold 了解更多
                                        .row.g-3
                                            .col-md-4
                                                a.btn.btn-outline-primary.w-100(href='portfolio-overview.html') 产品与方案
                                            .col-md-4
                                                a.btn.btn-outline-primary.w-100(href='portfolio-item.html') 技术能力
                                            .col-md-4
                                                a.btn.btn-primary.w-100(href='contact.html') 联系我们

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
