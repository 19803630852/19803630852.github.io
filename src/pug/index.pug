doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='上海亚格之芯技术有限公司专注 AI 推理加速芯片设计，核心产品 CMU 集网络、存储、传输与加速于一体。')
        meta(name='author', content='上海亚格之芯技术有限公司')

        title 上海亚格之芯技术有限公司 - AI 推理加速芯片 CMU

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header
            header.hero-tech.py-4
                .container.px-5
                    .row.gx-5.align-items-center.justify-content-between
                        .col-lg-7
                            .my-4
                                h1.display-6.fw-bolder.mb-3 上海亚格之芯技术有限公司
                                p.lead.fw-normal.text-muted.mb-4 亚格之芯成立于 2024 年底，总部位于上海，并在杭州设有芯片研发团队。公司自研 CMU，集网络、存储、传输与加速能力于一体，聚焦 AI 推理加速、AI 训练加速与 AI 云化三大核心场景，构建面向 AI 数据中心的芯片基础设施。
                        .col-lg-5.d-none.d-lg-block
                            .chip-visual.my-4
                                .chip-node.node-1 400G
                                .chip-node.node-2 KV Cache
                                .chip-core
                                    span.chip-core-label CMU
                                .chip-node.node-3 RDMA
                                .chip-node.node-4 AI 推理

            // Capabilities section
            section#features.py-4.section-muted
                .container.px-5.my-4
                    .row.gx-5.mb-4
                        .col-lg-8
                            h2.fw-bolder.mb-3 面向市场的核心竞争力
                    .capability-grid
                        .capability-item.capability-primary
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-lightning-charge
                                    h3.h4.fw-bold AI 推理加速
                                    p.text-muted.mb-3 通过 SSD 硬件直通、RDMA 跨节点传输与 GPU HBM 直写，优化 KV Cache 加载链路，减少 CPU 参与和 GPU 重算开销。
                                    p.text-muted.mb-4 支持与 vLLM、SGLang、LMCache 等推理框架协同。
                        .capability-item.capability-secondary
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-hdd-network
                                    h3.h4.fw-bold AI 训练加速
                                    p.text-muted.mb-2 内置 400G RDMA 高性能网络能力，解决多路径传输、乱序处理、拥塞控制与丢包重传等问题。
                                    p.text-muted.mb-0 基于开放以太网标准 RoCEv2，构建开放、高效的 AI 训练网络。
                        .capability-item.capability-secondary
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-diagram-3
                                    h3.h4.fw-bold AI 云化
                                    p.text-muted.mb-2 实现裸金属物理机的自动化部署、运维、安全隔离与资源调度，帮助物理算力对接云平台。
                                    p.text-muted.mb-0 将传统 1–2 天的人工部署与隔离流程缩短至 5–7 分钟。


        // Footer
        include includes/footer.pug

        include includes/scripts.pug
