doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='上海亚格之芯技术有限公司专注 AI 推理加速芯片设计，核心产品 CMU 集网络、存储、传输与加速于一体。')
        meta(name='author', content='上海亚格之芯技术有限公司')

        title 上海亚格之芯技术有限公司 - AI 推理加速芯片 CMU

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header
            header.home-hero
                .home-hero-grid
                .container.px-5
                    .row.gx-lg-5.align-items-center
                        .col-lg-7
                            .home-hero-copy
                                .hero-kicker
                                    span.hero-kicker-dot
                                    | AI INFRASTRUCTURE · FROM CHIP TO CLUSTER
                                h1 面向大模型时代的<br/>AI 基础设施芯片。
                                p.home-hero-lead 亚格之芯成立于 2024 年，团队位于上海与杭州。我们专注于 CMU 与 SuperNIC 产品研发，以软硬件协同能力服务 AI 云、模型训练与推理集群。
                                .hero-actions
                                    a.btn.btn-hero-primary(href='#products') 了解产品定位
                                        i.bi.bi-arrow-up-right
                                    a.btn.btn-hero-secondary(href='mailto:sales@yuccacloud.com?subject=商务合作咨询') 商务合作
                                .hero-proof
                                    .proof-item
                                        strong CMU + SuperNIC
                                        span 两条 AI 基础设施产品线
                                    .proof-divider
                                    .proof-item
                                        strong 上海 + 杭州
                                        span 架构、芯片与软硬协同
                                    .proof-divider
                                    .proof-item
                                        strong AI 云 · 训推集群
                                        span 面向 AI 基础设施场景
                        .col-lg-5.d-none.d-lg-block
                            .hero-chip-stage
                                .stage-corner.corner-tl
                                .stage-corner.corner-br
                                .stage-orbit.orbit-one
                                .stage-orbit.orbit-two
                                .stage-line.line-one
                                .stage-line.line-two
                                .stage-node.stage-node-top NETWORK
                                .stage-node.stage-node-right MEMORY
                                .stage-node.stage-node-bottom ACCELERATION
                                .stage-cmu
                                    span.stage-cmu-mark YUCCA
                                    strong CMU
                                    span.stage-cmu-sub COMPUTE · MEMORY · UNIT
                                .stage-caption
                                    span SYSTEM ON CHIP
                                    b AI DATA PATH

            // 01 Company
            section.company-overview.py-5
                .container.px-5
                    .section-heading
                        div
                            p.section-label 01 / COMPANY
                            h2 为 AI 算力基础设施而来。
                        p 亚格之芯聚焦 AI 基础设施芯片，围绕 AI 云的资源管理、推理的数据访问，以及训练与推理集群的高速通信，构建从芯片到软件栈的协同能力。
                    .company-pillars
                        article.company-pillar
                            span 01
                            h3 专注 AI 基础设施
                            p 从 GPU 服务器的资源纳管，到训练、推理数据在集群内流动，围绕真实 AI 工作负载设计产品能力。
                        article.company-pillar
                            span 02
                            h3 软硬件协同
                            p 将芯片硬件加速、网络与存储卸载、云平台与系统软件能力结合，缩短 AI 基础设施的关键数据路径。
                        article.company-pillar
                            span 03
                            h3 面向开放生态
                            p 基于标准以太网与开放协议构建产品，与 AI 云、服务器、存储和推理框架共同演进。

            // 02 Industry trends
            section#trends.ai-trends.py-5
                .container.px-5
                    .section-heading.section-heading-light
                        div
                            p.section-label 02 / AI INFRASTRUCTURE TRENDS
                            h2 大模型正在重塑<br/>算力基础设施。
                        p AI 工作负载不再只是单机计算问题。推理、训练与算力云的发展，让数据供给、集群通信与资源调度成为影响整体效率的关键环节。
                    .trend-visual(role='img', aria-label='AI 数据中心内的服务器集群与高速数据互联示意')
                        .trend-visual-caption
                            span AI INFRASTRUCTURE
                            strong COMPUTE · NETWORK · ORCHESTRATION
                    .trend-grid
                        article.trend-card
                            .trend-number 01
                            .trend-icon
                                i.bi.bi-lightning-charge-fill
                            h3 推理加速
                            p 大模型推理需要频繁加载与交换 KV Cache。如何缩短存储、网络与 GPU 之间的数据路径，成为降低推理等待的重要方向。
                            span KV Cache · 存储 I/O · GPU 数据路径
                        article.trend-card
                            .trend-number 02
                            .trend-icon
                                i.bi.bi-diagram-3-fill
                            h3 集群通信
                            p 分布式训练与推理依赖高带宽、低延迟的节点间通信。多路径传输、乱序处理与拥塞控制正在成为以太网 AI 集群的重要能力。
                            span RoCEv2 · RDMA · 400G 以太网
                        article.trend-card
                            .trend-number 03
                            .trend-icon
                                i.bi.bi-grid-1x2-fill
                            h3 弹性调度
                            p AI 云需要让 GPU 裸金属像云资源一样被交付、回收和运维，同时实现网络隔离、镜像切换与资源编排。
                            span 裸金属 · 网络隔离 · 生命周期管理

            // 03 Product positioning
            section#products.product-positioning.py-5
                .container.px-5
                    .section-heading
                        div
                            p.section-label 03 / PRODUCT POSITIONING
                            h2 两类产品，回应两类核心需求。
                        p SuperNIC 聚焦 AI 集群通信，CMU DPU 聚焦 AI 云与算力资源管理。二者在同一基础设施中协同，让通信与资源供给更贴近 AI 工作负载。
                    .product-position-grid
                        article.position-product.position-supernic
                            .position-product-top
                                span.product-tag SUPERNIC
                                span.product-state 测试阶段
                            h3 AI 超级网卡<br/><em>SuperNIC400</em>
                            p 面向大模型训练与推理集群的高速互联产品，将通信相关的数据面处理下沉到网卡侧。
                            .tech-stack
                                h4 技术栈
                                ul
                                    li
                                        strong 2 × 200G 聚合 400G
                                        span 高带宽以太网接口
                                    li
                                        strong RoCEv2 / RDMA
                                        span 协议与数据面硬件卸载
                                    li
                                        strong 多路径、乱序、拥塞控制
                                        span 面向复杂训练与推理流量
                            .position-product-bottom
                                span 核心场景：分布式训练 · 推理集群通信
                                a(href='mailto:sales@yuccacloud.com?subject=SuperNIC 产品咨询', aria-label='咨询 SuperNIC 产品')
                                    i.bi.bi-arrow-up-right
                        article.position-product.position-cmu
                            .position-product-top
                                span.product-tag CMU DPU
                                span.product-state.product-state-live 已商业落地
                            h3 AI 算力管理芯片<br/><em>CMU25 / CMU400</em>
                            p 面向 AI 云与弹性裸金属，将网络、存储与管理能力从主机侧卸载，为 GPU 资源接入云平台提供基础能力。
                            .tech-stack
                                h4 技术栈
                                ul
                                    li
                                        strong 专用计算与控制架构
                                        span 软硬协同的处理与控制平面
                                    li
                                        strong virtio / OVS 卸载
                                        span 网络与存储 I/O 基础能力
                                    li
                                        strong virtio-blk / virtio-fs
                                        span 系统镜像与 KV Cache 数据通路
                            .position-product-bottom
                                span 核心场景：AI 云 · 弹性裸金属 · 推理数据基础设施
                                a(href='portfolio-overview.html', aria-label='查看 CMU 产品详情')
                                    i.bi.bi-arrow-up-right
                    .product-note 产品阶段与规格以实际验证、测试及正式交付版本为准。
                    .product-cta
                        div
                            h2 与亚格之芯一起，构建下一代 AI 算力基础设施。
                            p 获取产品资料，或交流 AI 云、训练与推理集群的基础设施方案。
                        a.btn.btn-contact(href='mailto:sales@yuccacloud.com?subject=AI 算力基础设施合作咨询') 联系我们
                            i.bi.bi-arrow-up-right


        // Footer
        include includes/footer.pug

        include includes/scripts.pug
