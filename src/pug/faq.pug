doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='加入上海亚格之芯技术有限公司，参与 DPU 芯片从 FPGA 验证到 ASIC 量产的全生命周期。')
        meta(name='author', content='上海亚格之芯技术有限公司')

        title 加入我们 - 上海亚格之芯技术有限公司

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Page header
            header.page-hero.page-hero-careers.py-5
                .container.px-5
                    .row.gx-5.align-items-center.justify-content-between
                        .col-xl-8
                            .eyebrow.mb-3 招聘信息
                            h1.display-6.fw-bolder.mb-3 加入我们，一起把芯片做到量产
                            p.lead.text-muted.mb-4 直击大模型训练与推理的真实痛点，参与 DPU 芯片从 FPGA 验证、原型联调到 ASIC 量产的完整生命周期。
                            .d-flex.flex-wrap.gap-2
                                span.badge.career-badge 核心研发岗位
                                span.badge.career-badge 芯片全生命周期
                                span.badge.career-badge 年薪最高 300W + 期权
                        .col-xl-4.d-none.d-xl-block
                            .career-hero-panel
                                .career-hero-panel-label 核心研发岗位
                                .display-4.fw-bolder.text-primary 3
                                p.text-muted.mb-0 类岗位开放招聘

            // Open roles
            section.py-5.section-muted
                .container.px-5.my-3
                    .row.gx-5.align-items-end.mb-5
                        .col-lg-7
                            .eyebrow.mb-2 OPEN ROLES
                            h2.fw-bolder.mb-0 热招岗位
                        .col-lg-5
                            p.text-muted.mb-0 当前岗位主要面向杭州余杭研发团队；上海研发岗位将后续开放，欢迎持续关注。
                    #accordionCareers.accordion.career-accordion
                        .accordion-item
                            h3#headingOne.accordion-header
                                button.accordion-button(type='button' data-bs-toggle='collapse' data-bs-target='#collapseOne' aria-expanded='true' aria-controls='collapseOne')
                                    span.fw-bold 芯片验证工程师 / 专家
                                    span.badge.bg-primary.bg-gradient.ms-3 高优先级 · 数人
                            #collapseOne.accordion-collapse.collapse.show(aria-labelledby='headingOne' data-bs-parent='#accordionCareers')
                                .accordion-body.p-4.p-lg-5
                                    .job-meta.d-flex.flex-wrap.gap-2.mb-4
                                        span.job-meta-item
                                            i.bi.bi-cash-coin.me-2
                                            | 年薪 100W–300W + 期权
                                        span.job-meta-item
                                            i.bi.bi-geo-alt.me-2
                                            | 工作地址：浙江省杭州市余杭区
                                    .row.gx-5
                                        .col-lg-6.mb-4.mb-lg-0
                                            h4.job-section-title 岗位职责
                                            ol.ps-3.text-muted.mb-0
                                                li.mb-3 主导芯片验证全流程，具备完整流片经验。
                                                li.mb-3 负责芯片验证团队的搭建、管理与建设工作。
                                                li 统筹 DPU 芯片验证相关技术规划与落地，把控项目关键节点。
                                        .col-lg-6
                                            h4.job-section-title 任职要求
                                            ol.ps-3.text-muted.mb-0
                                                li.mb-3 具备完整芯片流片经验。
                                                li.mb-3 熟悉智能网卡、DPU 芯片相关技术者优先。
                                                li 具备团队搭建与管理能力。

                        .accordion-item
                            h3#headingTwo.accordion-header
                                button.accordion-button.collapsed(type='button' data-bs-toggle='collapse' data-bs-target='#collapseTwo' aria-expanded='false' aria-controls='collapseTwo')
                                    span.fw-bold 数字 IC 验证工程师
                                    span.badge.bg-info.text-dark.ms-3 20+ 人 · 初/中/高级
                            #collapseTwo.accordion-collapse.collapse(aria-labelledby='headingTwo' data-bs-parent='#accordionCareers')
                                .accordion-body.p-4.p-lg-5
                                    .job-meta.d-flex.flex-wrap.gap-2.mb-4
                                        span.job-meta-item
                                            i.bi.bi-people.me-2
                                            | 招聘层级：初级、中级、高级工程师均有需求
                                        span.job-meta-item
                                            i.bi.bi-cash-coin.me-2
                                            | 薪资待遇：面议
                                        span.job-meta-item
                                            i.bi.bi-geo-alt.me-2
                                            | 工作地址：浙江省杭州市余杭区
                                    .row.gx-5
                                        .col-lg-6.mb-4.mb-lg-0
                                            h4.job-section-title 岗位职责
                                            ol.ps-3.text-muted.mb-0
                                                li.mb-3
                                                    strong.text-dark 全流程验证：
                                                    | 负责 DPU 芯片级及子系统级验证全流程，涵盖验证方案起草、验证环境搭建、验证策略制定及覆盖率收敛管理工作。
                                                li.mb-3
                                                    strong.text-dark 架构仿真与分析：
                                                    | 深入理解 DPU 架构，承担系统级功能与性能验证工作（含吞吐量、时延、丢包模型等），协助设计团队定位架构瓶颈并完成性能调优。
                                                li.mb-3
                                                    strong.text-dark 组件开发与自动化建设：
                                                    | 规划并编写高复用性验证平台组件（BFM/Scoreboard）及自动化脚本，推动验证工具链升级，提升大规模回归测试效率。
                                                li
                                                    strong.text-dark 全栈联调：
                                                    | 深度参与芯片原型（FPGA/Emulator）验证，支持底层驱动开发及软硬件协同模拟，保障硬件逻辑与软件协议栈的适配匹配。
                                        .col-lg-6
                                            h4.job-section-title 任职要求
                                            ol.ps-3.text-muted.mb-0
                                                li.mb-3 电子、通信、计算机等相关专业，本科及以上学历，5 年及以上 ASIC/SoC 验证工作经验；拥有 DPU、高性能网络芯片、高速存储芯片项目经验者优先。
                                                li.mb-3 精通 SystemVerilog 语言及 UVM 验证方法学，具备从零搭建复杂验证环境的能力，深入理解覆盖率驱动验证（CDV）及断言（SVA）技术。
                                                li.mb-3 逻辑思维能力突出，具备敏锐的 Bug 发现与追踪能力，拥有良好的团队沟通协作能力及抗压能力。
                                                li 熟悉 PCIe/CXL、以太网协议栈（MAC/PCS）、RDMA（RoCEv2）、NVMe、虚拟化技术（SR-IOV）、加密算法加速中任意一项协议或技术者优先。

                        .accordion-item
                            h3#headingThree.accordion-header
                                button.accordion-button.collapsed(type='button' data-bs-toggle='collapse' data-bs-target='#collapseThree' aria-expanded='false' aria-controls='collapseThree')
                                    span.fw-bold 芯片设计工程师
                                    span.badge.bg-info.text-dark.ms-3 10 人
                            #collapseThree.accordion-collapse.collapse(aria-labelledby='headingThree' data-bs-parent='#accordionCareers')
                                .accordion-body.p-4.p-lg-5
                                    .job-meta.d-flex.flex-wrap.gap-2.mb-4
                                        span.job-meta-item
                                            i.bi.bi-cash-coin.me-2
                                            | 薪资待遇：面议
                                        span.job-meta-item
                                            i.bi.bi-geo-alt.me-2
                                            | 工作地址：浙江省杭州市余杭区
                                    .row.gx-5
                                        .col-lg-6.mb-4.mb-lg-0
                                            h4.job-section-title 岗位职责
                                            ol.ps-3.text-muted.mb-0
                                                li.mb-3 负责 DPU 及网络加速芯片的前端及后端全流程设计开发。
                                                li.mb-3 参与芯片架构定义与模块划分，完成核心 IP/模块的 RTL 代码编写与自测。
                                                li.mb-3 主导时序分析、功耗优化与面积优化（PPA），确保芯片性能指标达标。
                                                li 协同验证、封测及底层软件团队，完成芯片整机联调与量产导入。
                                        .col-lg-6
                                            h4.job-section-title 任职要求
                                            ol.ps-3.text-muted.mb-0
                                                li.mb-3 电子、微电子等相关专业本科及以上学历，5 年及以上经验，具备扎实的数字电路设计基础。
                                                li.mb-3 熟练掌握 Verilog/SystemVerilog 等硬件描述语言，具备独立编码与仿真能力，熟悉主流 EDA 工具链。
                                                li 熟悉 ASIC 设计流程，对综合、布局布线、时钟树结构（CTS）有深入理解。
                                            .job-highlight.mt-4
                                                strong 加分项：
                                                | 有高速接口（PCIe/Ethernet）、缓存一致性设计、网络报文处理或数据流加速芯片设计经验者优先。

                    .row.gx-5.mt-4
                        .col-12
                            .career-apply-panel
                                .row.gx-5.align-items-start
                                    .col-lg-7.mb-4.mb-lg-0
                                        h3.h5.fw-bolder.mb-3 招聘加分项
                                        ul.bonus-list.list-unstyled.mb-0
                                            li
                                                i.bi.bi-check-circle-fill.me-2
                                                | 有国产 RDMA 网卡、智能网卡芯片完整流片验证经验。
                                            li
                                                i.bi.bi-check-circle-fill.me-2
                                                | 有参与过其他领域流片芯片的验证经验。
                                            li
                                                i.bi.bi-check-circle-fill.me-2
                                                | 熟悉 NCCL、NVMeoF 等 RDMA 上层应用场景。
                                            li
                                                i.bi.bi-check-circle-fill.me-2
                                                | 具备验证平台自动化优化、脚本开发、工具二次开发能力。
                                            li
                                                i.bi.bi-check-circle-fill.me-2
                                                | 适配初创公司节奏，接受跨场景协作、主动补位工作模式。
                                    .col-lg-5
                                        .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                            svg.career-apply-icon(viewBox='0 0 24 24' aria-hidden='true' focusable='false')
                                                path(d='M3 4.75A2.75 2.75 0 0 1 5.75 2h4.5A2.75 2.75 0 0 1 13 4.75v.5h5.25A2.75 2.75 0 0 1 21 8v9.25A2.75 2.75 0 0 1 18.25 20H5.75A2.75 2.75 0 0 1 3 17.25V8a2.75 2.75 0 0 1 2.75-2.75H11v-.5A.75.75 0 0 0 10.25 4h-4.5a.75.75 0 0 0-.75.75v.5H3v-.5Zm2.75 2.5A.75.75 0 0 0 5 8v9.25c0 .414.336.75.75.75h12.5a.75.75 0 0 0 .75-.75V8a.75.75 0 0 0-.75-.75H5.75Zm4.25 2h4v1.5h-4v-1.5Z')
                                        h2.h4.fw-bolder.mb-3 期待与你见面
                                        p.text-muted.mb-4 欢迎将简历发送至招聘邮箱，邮件主题请注明应聘岗位。
                                        p.mb-2
                                            strong.text-dark 招聘邮箱
                                        a.d-block.fw-bold.text-decoration-none.mb-4(href='mailto:hiring@yuccacloud.com?subject=亚格之芯招聘') hiring@yuccacloud.com
                                        a.btn.btn-primary(href='mailto:hiring@yuccacloud.com?subject=亚格之芯招聘') 投递简历

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
