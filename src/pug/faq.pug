doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='加入上海亚格之芯技术有限公司，参与 DPU 芯片从验证、联调到量产的完整生命周期。')
        meta(name='author', content='上海亚格之芯技术有限公司')

        title 加入我们 - 上海亚格之芯技术有限公司

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Page header
            header.careers-hero
                .container.px-5
                    .row.gx-5.align-items-center.justify-content-between
                        .col-xl-8
                            .career-kicker
                                span.hero-kicker-dot
                                | CAREERS AT YUCCA
                            h1 参与定义<br/>下一代 AI 基础设施。
                            p.careers-hero-lead 我们正在构建面向 AI 云、训练与推理集群的基础设施芯片。加入亚格之芯，与架构、芯片、软件团队一起，将复杂的系统能力沉淀为可靠的产品。
                            .career-hero-actions
                                a.btn.btn-hero-primary(href='#open-roles') 查看开放岗位
                                    i.bi.bi-arrow-down
                                a.btn.btn-hero-secondary(href='mailto:hiring@yuccacloud.com?subject=亚格之芯招聘') 发送简历
                            .career-proof
                                .proof-item
                                    strong 杭州余杭
                                    span 当前研发岗位所在地
                                .proof-divider
                                .proof-item
                                    strong 6 类岗位
                                    span 芯片 · 网络 · 基础设施 · 硬件
                                .proof-divider
                                .proof-item
                                    strong 端到端协作
                                    span 从架构到产品落地
                        .col-xl-4.d-none.d-xl-block
                            .career-signal-panel
                                .signal-panel-top
                                    span BUILD THE FOUNDATION
                                    i.bi.bi-arrow-up-right
                                .signal-core
                                    span YUCCA
                                    strong AI
                                    em INFRASTRUCTURE
                                .signal-stream.stream-one
                                .signal-stream.stream-two
                                .signal-stream.stream-three
                                .signal-panel-bottom
                                    span OPEN ROLES
                                    strong 06

            // Career proposition
            section.career-proposition.py-5
                .container.px-5
                    .section-heading
                        div
                            p.section-label 01 / WHY YUCCA
                            h2 在关键问题上，<br/>做真正有影响力的工程。
                        p AI 基础设施的演进，离不开对芯片、系统软件和规模化部署的共同理解。这里的每个岗位，都会参与产品能力的完整链路。
                    .career-value-grid
                        article.career-value-card
                            span 01
                            i.bi.bi-cpu
                            h3 复杂系统，端到端参与
                            p 从架构定义、芯片开发与验证，到驱动、系统软件与场景联调，理解并参与产品如何成为基础设施。
                        article.career-value-card
                            span 02
                            i.bi.bi-diagram-3
                            h3 面向真实 AI 工作负载
                            p 围绕训练、推理、集群通信与 AI 云资源管理等问题，将技术深度转化为可验证、可演进的产品能力。
                        article.career-value-card
                            span 03
                            i.bi.bi-people
                            h3 与高密度团队协作
                            p 在架构、芯片、软件与产品团队之间快速迭代，用直接的沟通和工程方法解决难题。

            // Open roles
            section#open-roles.career-openings.py-5
