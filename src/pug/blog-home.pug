doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='云芯互联新闻动态，关注公司新闻、产品动态、技术文章和生态合作。')
        meta(name='author', content='云芯互联')

        title 新闻动态 - 云芯互联

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Featured story
            header.page-hero.py-5
                .container.px-5.py-5
                    .row.justify-content-center
                        .col-lg-9.text-center
                            .eyebrow.mb-3 Newsroom
                            h1.display-5.fw-bolder.mb-3 新闻动态
                            p.lead.text-white-50.mb-0 关注云芯互联在产品、技术、生态与产业合作方向的最新进展。

            section.py-5
                .container.px-5
                    .card.border-0.shadow.rounded-3.overflow-hidden
                        .card-body.p-0
                            .row.gx-0
                                .col-lg-6.col-xl-5.py-lg-5
                                    .p-4.p-md-5
                                        .badge.bg-primary.bg-gradient.rounded-pill.mb-2 产品动态
                                        .h2.fw-bolder 云芯互联推出面向 AI 集群的高速互联参考方案
                                        p.text-muted 围绕大规模训练集群的高带宽、低时延和可观测需求，提供从芯片到系统的联合验证路径。
                                        a.stretched-link.text-decoration-none(href='blog-post.html')
                                            | 阅读详情
                                            i.bi.bi-arrow-right.ms-1
                                .col-lg-6.col-xl-7
                                    .news-visual.h-100

            // News list
            section.py-5.section-muted
                .container.px-5
                    .row.gx-5
                        .col-xl-8
                            h2.fw-bolder.fs-5.mb-4 最新资讯
                            .mb-4
                                .small.text-muted 2026年6月
                                a.link-dark.text-decoration-none(href='blog-post.html')
                                    h3.h4 云芯互联完成数据中心互联方案联合验证
                                p.text-muted.mb-0 与生态伙伴围绕服务器、交换网络和软件工具链开展系统级测试。
                            .mb-4
                                .small.text-muted 2026年5月
                                a.link-dark.text-decoration-none(href='blog-post.html')
                                    h3.h4 面向智能计算网络的低时延技术实践
                                p.text-muted.mb-0 分享在队列管理、拥塞控制和系统调优方向的工程经验。
                            .mb-4
                                .small.text-muted 2026年4月
                                a.link-dark.text-decoration-none(href='blog-post.html')
                                    h3.h4 云边端基础设施中的芯片级互联趋势
                                p.text-muted.mb-0 探讨云数据中心与边缘网络演进对芯片平台提出的新需求。
                            .mb-5.mb-xl-0
                                a.text-decoration-none.fw-bold(href='contact.html')
                                    | 媒体与生态合作联系
                                    i.bi.bi-arrow-right.ms-1
                        .col-xl-4
                            .card.border-0.h-100.shadow-sm
                                .card-body.p-4
                                    .h6.fw-bolder 新闻分类
                                    .d-flex.flex-wrap.gap-2.mb-4
                                        span.badge.bg-primary 公司新闻
                                        span.badge.bg-primary 产品动态
                                        span.badge.bg-primary 技术文章
                                        span.badge.bg-primary 生态合作
                                    .h6.fw-bolder 媒体联系
                                    p.text-muted.mb-4
                                        | 如需采访、资料或产业合作，请发送邮件至
                                        br
                                        a(href='mailto:media@cloudcore.example') media@cloudcore.example
                                    .h6.fw-bolder 关注我们
                                    a.fs-5.pe-3.link-dark(href='#!')
                                        i.bi-linkedin
                                    a.fs-5.pe-3.link-dark(href='#!')
                                        i.bi-chat-dots
                                    a.fs-5.link-dark(href='#!')
                                        i.bi-envelope

            // Featured stories
            section.py-5
                .container.px-5
                    h2.fw-bolder.fs-5.mb-4 推荐阅读
                    .row.gx-5
                        .col-lg-4.mb-5
                            .card.h-100.shadow.border-0.tech-card
                                .news-visual.rounded-top
                                .card-body.p-4
                                    .badge.bg-primary.bg-gradient.rounded-pill.mb-2 技术文章
                                    a.text-decoration-none.link-dark.stretched-link(href='blog-post.html')
                                        .h5.card-title.mb-3 高速互联架构如何支撑 AI 训练集群
                                    p.card-text.text-muted.mb-0 从网络拓扑、数据通路和拥塞控制角度理解关键指标。
                        .col-lg-4.mb-5
                            .card.h-100.shadow.border-0.tech-card
                                .news-visual.rounded-top
                                .card-body.p-4
                                    .badge.bg-primary.bg-gradient.rounded-pill.mb-2 生态合作
                                    a.text-decoration-none.link-dark.stretched-link(href='blog-post.html')
                                        .h5.card-title.mb-3 与产业伙伴共建智能算力网络生态
                                    p.card-text.text-muted.mb-0 推进软硬件适配、联合测试和行业场景落地。
                        .col-lg-4.mb-5
                            .card.h-100.shadow.border-0.tech-card
                                .news-visual.rounded-top
                                .card-body.p-4
                                    .badge.bg-primary.bg-gradient.rounded-pill.mb-2 公司新闻
                                    a.text-decoration-none.link-dark.stretched-link(href='blog-post.html')
                                        .h5.card-title.mb-3 云芯互联研发中心持续扩充核心团队
                                    p.card-text.text-muted.mb-0 面向芯片架构、验证、软件和解决方案方向招募人才。

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
