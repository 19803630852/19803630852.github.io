doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='亚格之芯产品介绍：Yucca DPU 与 Yucca SuperNIC，面向数据中心、智算中心和以太网 AI 训练网络。')
        meta(name='author', content='上海亚格之芯科技有限公司')

        title 产品介绍 - 上海亚格之芯科技有限公司

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Page Header
            header.page-hero.py-4
                .container.px-5
                    .row.justify-content-center
                        .col-lg-9.text-center
                            h1.display-6.fw-bolder.mb-3 产品介绍
                            p.lead.text-white-50.mb-0 Yucca DPU 与 Yucca SuperNIC 面向数据中心和智算中心，提升算力利用率、网络传输效率与系统可扩展能力。

            // Yucca DPU
            section.py-4
                .container.px-5.my-4
                    .row.gx-5.align-items-center.mb-5
                        .col-lg-5.mb-4.mb-lg-0
                            .gradient-panel.h-100
                        .col-lg-7
                            .badge.bg-primary.bg-gradient.rounded-pill.mb-3 Yucca DPU
                            h2.fw-bolder.mb-4 智算中心算力运营变革的关键
                            p.lead.text-muted Yucca DPU 是智算中心算力运营变革的关键，拥有强大弹性裸金属能力。可精细隔离物理 AI 服务器的网络、存储资源，实现多用户间高效流转，如同智算中心的“智能中枢”。
                            p.text-muted.mb-0 它能够提升算力利用率，降低运营成本，支撑大规模智算中心高效运作。
                    .row.gx-4.row-cols-1.row-cols-md-2
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 智能算力调配
                                    p.text-muted.mb-0 精细隔离物理 AI 服务器的网络、存储资源，实现多用户间高效流转。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 网络存储优化
                                    p.text-muted.mb-0 网络上全面支持 SRIOV、OVS Offload 等技术，构建高速稳定数据传输通道；存储方面支持 Ceph、iSCSI 等，满足不同场景数据存储需求。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 多元加速赋能
                                    p.text-muted.mb-0 融合 GPU Direct RDMA、PCIe P2P 等 AI 加速技术及先进虚拟化加速技术，降低系统开销。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 高效管控适配
                                    p.text-muted.mb-0 提供基于 libvirt 和基于 CNI 的管控适配，打造便捷高效管理平台，实现系统全面监控与精准控制。

            // Yucca SuperNIC
            section.py-4.section-muted
                .container.px-5.my-4
                    .row.gx-5.align-items-center.mb-5
                        .col-lg-7.order-2.order-lg-1
                            .badge.bg-primary.bg-gradient.rounded-pill.mb-3 Yucca SuperNIC
                            h2.fw-bolder.mb-4 AI 训练网络的高速引擎
                            p.lead.text-muted Yucca SuperNIC 专为解决以太网 AI 训练大规模数据传输难题，支持 GPU Direct RDMA 等 AI 加速技术，搭配标准 RoCEv2、自研及开放 UEC 协议。
                            p.text-muted.mb-0 它能够有效解决数据丢包、拥塞问题，提升传输效率与稳定性，保障 AI 训练网络。
                        .col-lg-5.order-1.order-lg-2.mb-4.mb-lg-0
                            .gradient-panel.h-100
                    .row.gx-4.row-cols-1.row-cols-md-2
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 超强网络传输
                                    p.text-muted.mb-0 支持 GPU Direct RDMA、标准 RoCEv2、自研及开放 UEC 协议，有效解决数据丢包与拥塞问题。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 高带宽低延迟
                                    p.text-muted.mb-0 总带宽高达 2x200Gbps 甚至更高，转发速率达 250Mpps，大幅降低延迟，支持 AI 训练实时数据交互。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 丰富功能集成
                                    p.text-muted.mb-0 集成 OVS 等网络加速功能与多种 RDMA 技术，后续版本将加入 Adaptive routing 等功能。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 灵活适配拓展
                                    p.text-muted.mb-0 拥有 PCIe Gen5x16 等 Host 接口与 Virtio Net 设备类型，可与各类 AI 服务器及网络环境适配。

            // CTA
            section.py-4
                .container.px-5.my-4
                    h2.fw-bolder.mb-3 需要了解 Yucca DPU 或 Yucca SuperNIC？
                    p.text-muted.mb-4 欢迎联系亚格之芯，获取产品资料、方案沟通或合作信息。
                    a.btn.btn-lg.btn-primary(href='contact.html') 联系我们

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
