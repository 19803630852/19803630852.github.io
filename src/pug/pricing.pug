doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='亚格之芯服务支持：产品资料、技术交流、方案适配与系统集成。')
        meta(name='author', content='上海亚格之芯科技有限公司')

        title 服务支持 - 上海亚格之芯科技有限公司

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Support section
            header.page-hero.py-4
                .container.px-5
                    .row.justify-content-center
                        .col-lg-8.text-center
                            h1.display-6.fw-bolder.mb-3 服务支持
                            p.lead.text-muted.mb-0 围绕 Yucca DPU 与 Yucca SuperNIC，为数据中心和智算中心场景提供产品资料、技术交流与系统适配支持。

            section.py-4
                .container.px-5.my-4
                    .row.gx-5.justify-content-center
                        .col-lg-6.col-xl-4.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-5
                                    .small.text-uppercase.fw-bold.text-primary 01
                                    h2.h4.fw-bold.my-3 产品资料
                                    p.text-muted 获取 Yucca DPU、Yucca SuperNIC 的产品能力、接口特性和应用场景说明。
                                    ul.list-unstyled.text-muted.mb-4
                                        li.mb-2
                                            i.bi.bi-check.text-primary.me-2
                                            | DPU 弹性裸金属能力
                                        li.mb-2
                                            i.bi.bi-check.text-primary.me-2
                                            | SuperNIC 高带宽低延迟能力
                                        li
                                            i.bi.bi-check.text-primary.me-2
                                            | RDMA / OVS / 存储支持能力
                                    a.btn.btn-outline-primary(href='contact.html') 联系咨询
                        .col-lg-6.col-xl-4.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-5
                                    .small.text-uppercase.fw-bold.text-primary 02
                                    h2.h4.fw-bold.my-3 技术交流
                                    p.text-muted 围绕 SRIOV、OVS Offload、Ceph、iSCSI、GPU Direct RDMA、RoCEv2、UEC 等技术开展沟通。
                                    ul.list-unstyled.text-muted.mb-4
                                        li.mb-2
                                            i.bi.bi-check.text-primary.me-2
                                            | 网络存储优化
                                        li.mb-2
                                            i.bi.bi-check.text-primary.me-2
                                            | AI 加速与虚拟化加速
                                        li
                                            i.bi.bi-check.text-primary.me-2
                                            | libvirt / CNI 管控适配
                                    a.btn.btn-primary(href='contact.html') 申请交流
                        .col-lg-6.col-xl-4.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-5
                                    .small.text-uppercase.fw-bold.text-primary 03
                                    h2.h4.fw-bold.my-3 方案适配
                                    p.text-muted 面向各类 AI 服务器及网络环境，支持系统集成、功能升级和性能演进。
                                    ul.list-unstyled.text-muted.mb-4
                                        li.mb-2
                                            i.bi.bi-check.text-primary.me-2
                                            | PCIe Gen5x16 Host 接口
                                        li.mb-2
                                            i.bi.bi-check.text-primary.me-2
                                            | Virtio Net 设备类型
                                        li
                                            i.bi.bi-check.text-primary.me-2
                                            | Adaptive routing 等演进方向
                                    a.btn.btn-outline-primary(href='contact.html') 获取支持

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
