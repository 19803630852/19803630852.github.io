doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='了解上海亚格之芯科技有限公司：以创新为核心，深耕数据中心和智算中心网络技术领域。')
        meta(name='author', content='上海亚格之芯科技有限公司')

        title 关于我们 - 上海亚格之芯科技有限公司

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header
            header.page-hero.py-4
                .container.px-5
                    .row.justify-content-center
                        .col-lg-9.col-xxl-8
                            .text-center.my-3
                                h1.display-6.fw-bolder.mb-3 关于我们
                                p.lead.text-white-50.mb-0 上海亚格之芯科技有限公司以创新精神和技术底蕴，深耕数据中心与智算中心网络技术领域。

            // Company profile
            section.py-4
                .container.px-5.my-4
                    .row.gx-5.align-items-center
                        .col-lg-6.mb-5.mb-lg-0
                            h2.fw-bolder.mb-4 在数字化浪潮中，屹立于网络科技前沿
                            p.lead.text-muted 在数字化浪潮与全球网络格局变革中，亚格之芯凭借创新精神和技术底蕴，屹立于网络科技前沿。作为行业领军企业，它汇聚全球顶尖人才组建研发团队。
                            p.text-muted.mb-0 亚格之芯以创新为核心，在数据中心和智算中心研发成果显著，核心产品 DPU 和 SuperNIC 表现卓越。
                        .col-lg-6
                            .row.g-3
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary DPU
                                        .text-muted 弹性裸金属与算力调配
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary SuperNIC
                                        .text-muted AI 训练网络高速引擎
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary 2x200G
                                        .text-muted 高带宽传输能力
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary 250Mpps
                                        .text-muted 高转发速率

            // Vision section
            section.py-4.section-muted
                .container.px-5.my-4
                    .text-center.mb-5
                        h2.fw-bolder 创新理念与发展方向
                    .row.gx-4.row-cols-1.row-cols-md-3
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-lightbulb
                                    h3.h5.fw-bold 创新为核心
                                    p.text-muted.mb-0 持续深耕网络技术领域，以技术创新提升产品性能和系统效率。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-diagram-3
                                    h3.h5.fw-bold 拓展应用场景
                                    p.text-muted.mb-0 面向数据中心、智算中心和 AI 训练网络，不断拓展产品应用边界。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-globe2
                                    h3.h5.fw-bold 优质网络方案
                                    p.text-muted.mb-0 为全球提供优质网络方案，携手推动网络科技产业发展。

            // Product strengths
            section.py-4
                .container.px-5.my-4
                    .row.gx-5
                        .col-lg-4.mb-4.mb-lg-0
                            h2.fw-bolder 产品研发成果
                            p.text-muted 核心产品 DPU 和 SuperNIC 围绕算力调配、网络存储优化、AI 加速和灵活适配持续演进。
                        .col-lg-8
                            .timeline
                                .timeline-item
                                    h3.h5.fw-bold Yucca DPU · 智能算力调配
                                    p.text-muted.mb-0 作为智算中心算力运营变革的关键，拥有强大弹性裸金属能力，提升算力利用率，降低运营成本。
                                .timeline-item
                                    h3.h5.fw-bold Yucca DPU · 网络存储优化
                                    p.text-muted.mb-0 全面支持 SRIOV、OVS Offload、Ceph、iSCSI 等技术，保障数据存储与读取的高效可靠。
                                .timeline-item
                                    h3.h5.fw-bold Yucca SuperNIC · 超强网络传输
                                    p.text-muted.mb-0 专为解决以太网 AI 训练大规模数据传输难题，支持 GPU Direct RDMA、RoCEv2 与 UEC 协议。
                                .timeline-item
                                    h3.h5.fw-bold Yucca SuperNIC · 灵活适配拓展
                                    p.text-muted.mb-0 拥有 PCIe Gen5x16 等 Host 接口与 Virtio Net 设备类型，便于系统集成与升级。

            // Culture
            section.py-4.section-muted
                .container.px-5.my-4
                    .text-center.mb-5
                        h2.fw-bolder 开启网络技术新篇章
                        p.lead.text-muted.mb-0 未来，亚格之芯将继续秉持创新理念，深耕网络技术领域，提升产品性能，拓展应用场景。
                    .row.gx-4.row-cols-1.row-cols-sm-2.row-cols-xl-4
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-cpu
                                h3.h5.fw-bold 研发团队
                                p.text-muted.mb-0 汇聚全球顶尖人才，持续投入核心技术研发。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-cpu
                                h3.h5.fw-bold 产品创新
                                p.text-muted.mb-0 围绕 DPU 与 SuperNIC 打造面向智算中心的产品能力。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-speedometer2
                                h3.h5.fw-bold 性能提升
                                p.text-muted.mb-0 持续提升网络传输、存储访问和 AI 加速效率。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-people
                                h3.h5.fw-bold 产业协同
                                p.text-muted.mb-0 携手推动网络科技产业发展，开启网络技术新篇章。

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
