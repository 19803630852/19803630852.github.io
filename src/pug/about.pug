doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='了解上海亚格之芯技术有限公司：成立于 2024 年底，专注 AI 推理加速芯片 CMU 的设计与研发。')
        meta(name='author', content='上海亚格之芯技术有限公司')

        title 关于我们 - 上海亚格之芯技术有限公司

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header
            header.page-hero.page-hero-about.py-4
                .container.px-5
                    .row.justify-content-center
                        .col-lg-9.col-xxl-8
                            .text-center.my-3
                                h1.display-6.fw-bolder.mb-3 关于我们
                                p.lead.text-muted.mb-0 专注 AI 推理加速芯片设计，打造面向推理加速、训练加速与 AI 云化的国产 CMU 产品。

            // Company profile
            section.py-4
                .container.px-5.my-4
                    .row.gx-5.align-items-center
                        .col-lg-6.mb-5.mb-lg-0
                            h2.fw-bolder.mb-4 聚焦 AI 推理加速芯片
                            p.lead.text-muted 亚格之芯成立于 2024 年底，总部位于上海，并在杭州设有芯片研发团队，目前团队规模 30 余人。
                            p.text-muted.mb-0 公司自研 CMU（Compute & Memory Unit），集网络、存储、传输与加速于一体，定位 NVIDIA BlueField DPU 的国产替代方案，全面聚焦 AI 场景。
                        .col-lg-6
                            .row.g-3
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary 2024
                                        .text-muted 年底成立
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary 30+
                                        .text-muted 上海与杭州研发团队
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary CMU
                                        .text-muted 自研一体化 SoC 芯片
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary 800G
                                        .text-muted RDMA 高性能网络

            // Product strengths
            section.py-4
                .container.px-5.my-4
                    .row.gx-5
                        .col-lg-4.mb-4.mb-lg-0
                            h2.fw-bolder CMU 产品与交付能力
                            p.text-muted CMU 聚焦 AI 推理加速、AI 训练加速与 AI 云化三大产品能力，并通过标准芯片、PCIe 板卡及接口文档支持客户完成系统集成。
                        .col-lg-8
                            .timeline
                                .timeline-item
                                    h3.h5.fw-bold AI 推理加速
                                    p.text-muted.mb-0 通过 SSD 硬件直通、RDMA 跨节点传输与 GPU HBM 直写，优化 KV Cache 加载链路，并与主流推理框架协同。
                                .timeline-item
                                    h3.h5.fw-bold AI 训练加速
                                    p.text-muted.mb-0 面向 800G RDMA 网络，处理多路径、乱序、拥塞控制与丢包重传，构建开放以太网训练基础设施。
                                .timeline-item
                                    h3.h5.fw-bold AI 云化
                                    p.text-muted.mb-0 实现裸金属物理机的自动化部署、运维、安全隔离与资源调度，帮助物理算力对接云平台。
                                .timeline-item
                                    h3.h5.fw-bold 标准化交付
                                    p.text-muted.mb-0 提供 CMU 芯片与标准 PCIe 板卡及接口文档，支持客户完成云平台和应用系统集成。

            // Culture
            section.py-4.section-muted
                .container.px-5.my-4
                    .text-center.mb-5
                        h2.fw-bolder 开启网络技术新篇章
                        p.lead.text-muted.mb-0 未来，亚格之芯将继续秉持创新理念，深耕网络技术领域，提升产品性能，拓展应用场景。
                    .row.gx-4.row-cols-1.row-cols-sm-2.row-cols-xl-4
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-cpu
                                h3.h5.fw-bold 研发团队
                                p.text-muted.mb-0 汇聚全球顶尖人才，持续投入核心技术研发。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-cpu
                                h3.h5.fw-bold 产品创新
                                p.text-muted.mb-0 围绕 CMU 打造面向 AI 推理、训练与云化场景的产品能力。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-speedometer2
                                h3.h5.fw-bold 性能提升
                                p.text-muted.mb-0 持续提升网络传输、存储访问和 AI 加速效率。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-people
                                h3.h5.fw-bold 产业协同
                                p.text-muted.mb-0 携手推动网络科技产业发展，开启网络技术新篇章。

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
