doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='了解云芯互联：一家专注于高速网络互联芯片与智能计算基础设施解决方案的科技企业。')
        meta(name='author', content='云芯互联')

        title 关于我们 - 云芯互联

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header
            header.page-hero.py-5
                .container.px-5.py-5
                    .row.justify-content-center
                        .col-lg-9.col-xxl-8
                            .text-center.my-4
                                .eyebrow.mb-3 About CloudCore
                                h1.display-5.fw-bolder.mb-3 关于云芯互联
                                p.lead.text-white-50.mb-0 以芯片创新连接云、边、端智能基础设施，让高速互联成为智能计算时代的可靠底座。

            // Company profile
            section.py-5
                .container.px-5.my-5
                    .row.gx-5.align-items-center
                        .col-lg-6.mb-5.mb-lg-0
                            .eyebrow.mb-2 Company Profile
                            h2.fw-bolder.mb-4 专注高速互联芯片与智能算力基础设施
                            p.lead.text-muted 云芯互联是一家专注于高速网络互联芯片与智能计算基础设施解决方案的科技企业。公司围绕云数据中心、AI 计算集群和边缘网络场景，持续推进高性能、低功耗、低时延芯片架构创新。
                            p.text-muted.mb-0 我们以芯片架构、关键 IP、系统软件和场景验证为核心能力，帮助客户构建可扩展、可运维、面向未来演进的网络基础设施。
                        .col-lg-6
                            .row.g-3
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary 100G+
                                        .text-muted 高速互联方向
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary AI
                                        .text-muted 智能计算场景
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary 24/7
                                        .text-muted 企业级可靠支持
                                .col-6
                                    .stat-card.p-4.h-100
                                        .display-6.fw-bold.text-primary 多场景
                                        .text-muted 云边端基础设施

            // Mission section
            section.py-5.section-muted
                .container.px-5.my-5
                    .text-center.mb-5
                        .eyebrow.mb-2 Mission
                        h2.fw-bolder 使命、愿景与价值观
                    .row.gx-4.row-cols-1.row-cols-md-3
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-bullseye
                                    h3.h5.fw-bold 使命
                                    p.text-muted.mb-0 让智能计算基础设施连接更高效，以芯片创新提升数据流动效率。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-stars
                                    h3.h5.fw-bold 愿景
                                    p.text-muted.mb-0 成为可信赖的云数据中心互联芯片伙伴，服务产业长期演进。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    .feature.bg-primary.bg-gradient.text-white.rounded-3.mb-3
                                        i.bi.bi-shield-check
                                    h3.h5.fw-bold 价值观
                                    p.text-muted.mb-0 坚持技术创新、客户成功、开放协作和长期主义。

            // Milestones
            section.py-5
                .container.px-5.my-5
                    .row.gx-5
                        .col-lg-4.mb-4.mb-lg-0
                            .eyebrow.mb-2 Milestones
                            h2.fw-bolder 发展历程
                            p.text-muted 这里使用示例里程碑，后续可替换为真实公司发展节点。
                        .col-lg-8
                            .timeline
                                .timeline-item
                                    h3.h5.fw-bold 2021 · 核心团队组建
                                    p.text-muted.mb-0 启动高速互联芯片架构和关键 IP 的技术预研。
                                .timeline-item
                                    h3.h5.fw-bold 2022 · 原型平台验证
                                    p.text-muted.mb-0 完成核心模块原型与系统级验证流程搭建。
                                .timeline-item
                                    h3.h5.fw-bold 2023 · 场景方案验证
                                    p.text-muted.mb-0 围绕云数据中心和 AI 集群场景开展方案验证。
                                .timeline-item
                                    h3.h5.fw-bold 2024 · 生态合作推进
                                    p.text-muted.mb-0 与产业伙伴开展联合测试、系统适配和客户验证。
                                .timeline-item
                                    h3.h5.fw-bold 2025+ · 持续迭代演进
                                    p.text-muted.mb-0 面向规模化应用持续优化性能、可靠性和可运维能力。

            // R&D capabilities
            section.py-5.section-muted
                .container.px-5.my-5
                    .text-center.mb-5
                        .eyebrow.mb-2 R&D
                        h2.fw-bolder 研发与工程能力
                        p.lead.text-muted.mb-0 以芯片、软件、系统和客户场景验证形成闭环。
                    .row.gx-4.row-cols-1.row-cols-md-2.row-cols-xl-3
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 芯片架构设计
                                    p.text-muted.mb-0 面向不同带宽、协议和系统需求设计可扩展架构。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 高速 SerDes 与接口
                                    p.text-muted.mb-0 支撑高速信号、接口适配和可靠链路能力建设。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 网络协议与转发
                                    p.text-muted.mb-0 覆盖转发、队列、拥塞控制和可观测能力。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 软件工具链
                                    p.text-muted.mb-0 提供驱动、SDK、调试和部署工具支撑。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 系统级性能优化
                                    p.text-muted.mb-0 从芯片到服务器、交换网络和应用负载进行联合优化。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h5.fw-bold 可靠性与量产支持
                                    p.text-muted.mb-0 支持工程验证、可靠性测试和客户导入流程。

            // Culture
            section.py-5
                .container.px-5.my-5
                    .text-center.mb-5
                        .eyebrow.mb-2 Culture
                        h2.fw-bolder 团队与文化
                        p.lead.text-muted.mb-0 以跨学科团队协作，推动芯片技术走向真实产业场景。
                    .row.gx-4.row-cols-1.row-cols-sm-2.row-cols-xl-4
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-cpu
                                h3.h5.fw-bold 研发团队
                                p.text-muted.mb-0 聚焦芯片架构、验证和关键 IP。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-boxes
                                h3.h5.fw-bold 产品方案
                                p.text-muted.mb-0 连接客户需求与系统方案落地。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-headset
                                h3.h5.fw-bold 客户支持
                                p.text-muted.mb-0 支持联合验证、部署和调优。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3
                                    i.bi.bi-people
                                h3.h5.fw-bold 生态合作
                                p.text-muted.mb-0 与产业伙伴共建智能算力网络生态。

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
