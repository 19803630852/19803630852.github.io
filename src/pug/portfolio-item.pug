doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='云芯互联核心技术能力，覆盖高速互联架构、可编程数据平面、硬件卸载与端到端验证体系。')
        meta(name='author', content='云芯互联')

        title 技术能力 - 云芯互联

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Page Header
            header.page-hero.py-5
                .container.px-5.py-5
                    .row.gx-5.align-items-center
                        .col-lg-7
                            .eyebrow.mb-3 Technology
                            h1.display-5.fw-bolder.mb-3 核心技术能力
                            p.lead.text-white-50.mb-0 从芯片架构到系统软件，从仿真验证到客户现场调优，构建面向智能计算网络的工程闭环。
                        .col-lg-5.d-none.d-lg-block
                            .chip-visual
                                .chip-node.node-1 架构
                                .chip-node.node-2 协议
                                .chip-core
                                .chip-node.node-3 软件
                                .chip-node.node-4 验证

            // Architecture areas
            section.py-5
                .container.px-5.my-5
                    .text-center.mb-5
                        .eyebrow.mb-2 Platform
                        h2.fw-bolder 技术平台
                        p.lead.text-muted.mb-0 围绕高带宽、低时延、可扩展和可运维四个目标持续演进。
                    .row.gx-4.row-cols-1.row-cols-md-2
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h4.fw-bold 高速互联架构
                                    p.text-muted.mb-0 面向大规模集群网络设计高吞吐、低抖动的数据通路，支持多代带宽和拓扑演进。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h4.fw-bold 可编程数据平面
                                    p.text-muted.mb-0 通过灵活的转发、匹配和处理能力，适配云原生、虚拟化和行业专用网络需求。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h4.fw-bold 硬件卸载与加速
                                    p.text-muted.mb-0 将网络、存储和安全等基础设施任务下沉到专用硬件，提高主机资源利用效率。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h4.fw-bold 端到端验证体系
                                    p.text-muted.mb-0 覆盖仿真、FPGA 原型、系统测试和客户场景验证，降低导入风险。

            // Technical highlights
            section.py-5.section-muted
                .container.px-5.my-5
                    .row.gx-5.align-items-center
                        .col-lg-5.mb-4.mb-lg-0
                            .eyebrow.mb-2 Highlights
                            h2.fw-bolder.mb-3 技术特性
                            p.text-muted.mb-0 以系统级指标驱动芯片和软件协同设计，持续优化性能、可靠性和部署体验。
                        .col-lg-7
                            .row.g-3
                                .col-sm-6
                                    .stat-card.p-4
                                        h3.h5.fw-bold 低时延
                                        p.text-muted.mb-0 面向实时数据流优化关键路径。
                                .col-sm-6
                                    .stat-card.p-4
                                        h3.h5.fw-bold 高吞吐
                                        p.text-muted.mb-0 支撑大规模东西向网络流量。
                                .col-sm-6
                                    .stat-card.p-4
                                        h3.h5.fw-bold 可扩展
                                        p.text-muted.mb-0 适配多带宽、多协议和多场景演进。
                                .col-sm-6
                                    .stat-card.p-4
                                        h3.h5.fw-bold 高可靠
                                        p.text-muted.mb-0 面向企业级部署构建可靠性机制。

            // Process
            section.py-5
                .container.px-5.my-5
                    .text-center.mb-5
                        h2.fw-bolder 工程交付流程
                        p.lead.text-muted.mb-0 从需求到量产导入的协同路径。
                    .row.gx-4.row-cols-1.row-cols-md-4
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3 1
                                h3.h5.fw-bold 场景评估
                                p.text-muted.mb-0 梳理业务负载、网络拓扑和关键指标。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3 2
                                h3.h5.fw-bold 方案设计
                                p.text-muted.mb-0 定义芯片、软件和系统集成方案。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3 3
                                h3.h5.fw-bold 联合验证
                                p.text-muted.mb-0 在客户环境中验证性能与可靠性。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3 4
                                h3.h5.fw-bold 导入支持
                                p.text-muted.mb-0 支持部署、调优和后续版本演进。

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
