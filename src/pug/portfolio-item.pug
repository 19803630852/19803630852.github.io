doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='亚格之芯技术能力：SRIOV、OVS Offload、Ceph、iSCSI、GPU Direct RDMA、PCIe P2P、RoCEv2、UEC、PCIe Gen5x16 与 Virtio Net。')
        meta(name='author', content='上海亚格之芯科技有限公司')

        title 技术能力 - 上海亚格之芯科技有限公司

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Page Header
            header.page-hero.py-4
                .container.px-5
                    .row.gx-5.align-items-center
                        .col-lg-7
                            h1.display-6.fw-bolder.mb-3 技术能力
                            p.lead.text-white-50.mb-0 围绕 DPU、SuperNIC、AI 加速和网络存储优化，亚格之芯构建面向数据中心与智算中心的核心技术能力。
                        .col-lg-5.d-none.d-lg-block
                            .chip-visual
                                .chip-node.node-1 SRIOV
                                .chip-node.node-2 RDMA
                                .chip-core
                                .chip-node.node-3 UEC
                                .chip-node.node-4 CNI

            // Technology areas
            section.py-4
                .container.px-5.my-4
                    .text-center.mb-5
                        h2.fw-bolder 技术体系
                        p.lead.text-muted.mb-0 以网络、存储、AI 加速、虚拟化和管控适配构成产品竞争力。
                    .row.gx-4.row-cols-1.row-cols-md-2
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h4.fw-bold SRIOV 与 OVS Offload
                                    p.text-muted.mb-0 网络上全面支持 SRIOV、OVS Offload 等技术，构建高速稳定数据传输通道，提升网络处理效率。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h4.fw-bold Ceph 与 iSCSI 存储支持
                                    p.text-muted.mb-0 存储方面支持 Ceph、iSCSI 等能力，满足不同场景数据存储需求，保障数据存储与读取的高效可靠。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h4.fw-bold GPU Direct RDMA 与 PCIe P2P
                                    p.text-muted.mb-0 融合 GPU Direct RDMA、PCIe P2P 等 AI 加速技术，提升数据处理与传输效率，降低系统开销。
                        .col.mb-4
                            .card.tech-card.h-100.border-0.shadow-sm
                                .card-body.p-4
                                    h3.h4.fw-bold libvirt 与 CNI 管控适配
                                    p.text-muted.mb-0 提供基于 libvirt 和基于 CNI 的管控适配，实现系统全面监控、精准控制和资源合理利用。

            // SuperNIC highlights
            section.py-4.section-muted
                .container.px-5.my-4
                    .row.gx-5.align-items-center
                        .col-lg-5.mb-4.mb-lg-0
                            h2.fw-bolder.mb-3 面向以太网 AI 训练网络
                            p.text-muted.mb-0 Yucca SuperNIC 通过高带宽、低延迟和多协议支持，应对大规模 AI 训练网络的数据传输挑战。
                        .col-lg-7
                            .row.g-3
                                .col-sm-6
                                    .stat-card.p-4
                                        h3.h5.fw-bold 2x200Gbps+
                                        p.text-muted.mb-0 总带宽高达 2x200Gbps 甚至更高。
                                .col-sm-6
                                    .stat-card.p-4
                                        h3.h5.fw-bold 250Mpps
                                        p.text-muted.mb-0 转发速率达 250Mpps，支持高效转发。
                                .col-sm-6
                                    .stat-card.p-4
                                        h3.h5.fw-bold RoCEv2 / UEC
                                        p.text-muted.mb-0 搭配标准 RoCEv2、自研及开放 UEC 协议。
                                .col-sm-6
                                    .stat-card.p-4
                                        h3.h5.fw-bold PCIe Gen5x16
                                        p.text-muted.mb-0 拥有 PCIe Gen5x16 Host 接口与 Virtio Net 设备类型。

            // Evolution
            section.py-4
                .container.px-5.my-4
                    .text-center.mb-5
                        h2.fw-bolder 持续演进方向
                        p.lead.text-muted.mb-0 满足 AI 训练复杂网络需求，提供灵活高效网络方案。
                    .row.gx-4.row-cols-1.row-cols-md-4
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3 1
                                h3.h5.fw-bold 网络加速
                                p.text-muted.mb-0 集成 OVS 等网络加速功能。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3 2
                                h3.h5.fw-bold 多种 RDMA
                                p.text-muted.mb-0 支持多种 RDMA 技术并持续演进。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3 3
                                h3.h5.fw-bold Adaptive routing
                                p.text-muted.mb-0 后续版本将加入 Adaptive routing 等功能。
                        .col.mb-4
                            .text-center
                                .feature.bg-primary.bg-gradient.text-white.rounded-circle.mb-3 4
                                h3.h5.fw-bold 灵活升级
                                p.text-muted.mb-0 可随技术与业务发展升级功能与性能。

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
